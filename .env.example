# Server-Side Private Secrets (NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_backend_api_key_here
# Optional: path to serviceAccountKey.json for Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_PATH=

# Public Safe Client Configs (Exposed safely via /api/config/client)
FIREBASE_API_KEY=AIzaSyFakeClientApiKeyForLocalDev_000
FIREBASE_AUTH_DOMAIN=mindmirror-dev.firebaseapp.com
FIREBASE_PROJECT_ID=mindmirror-ideathon
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
GOOGLE_MAPS_CLIENT_KEY=

# Server runtime
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
